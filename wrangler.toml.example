# ============================================================================
# Cloudflare Pages reference configuration for the Remote Business Partner
# Recruitment Application.
#
# This file is intentionally an example rather than the live deployment
# configuration. The production Pages project may continue to use bindings and
# variables configured in the Cloudflare dashboard. Do not commit secrets.
# ============================================================================

name = "rbp-recruitment"
compatibility_date = "2026-08-23"
pages_build_output_dir = "."

# ----------------------------------------------------------------------------
# Production D1 database
# ----------------------------------------------------------------------------
# Cloudflare D1 binding used by Pages Functions as `env.DB`.
[[d1_databases]]
binding = "DB"
database_name = "rbp-recruitment"
database_id = "9e9d4e61-eb82-456e-a031-d82c58aa5b39"

# ----------------------------------------------------------------------------
# Production R2 bucket
# ----------------------------------------------------------------------------
# Keep this bucket private. Candidate CV files are accessed only through
# authenticated Pages Functions as `env.CV_BUCKET`.
[[r2_buckets]]
binding = "CV_BUCKET"
bucket_name = "rbp-recruitment-cvs"

# ----------------------------------------------------------------------------
# Public/non-secret runtime variables
# ----------------------------------------------------------------------------
[vars]
FIREBASE_PROJECT_ID = "business-plan-applicatio-17047"
BUSINESS_TIMEZONE = "Australia/Perth"
TURNSTILE_SITE_KEY = "REPLACE_WITH_TURNSTILE_SITE_KEY"
TURNSTILE_ALLOWED_HOSTNAMES = "remote-business-partner-recruitment-application.pages.dev"
CLOUDFLARE_ACCOUNT_ID = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
RECRUITMENT_EMAIL_FROM = "recruitment@remotebusinesspartner.com.au"
RECRUITMENT_NOTIFICATION_EMAIL = "recruitment@remotebusinesspartner.com.au"
PUBLIC_SITE_URL = "https://remote-business-partner-recruitment-application.pages.dev"

# Secrets are never committed. Configure both of these as encrypted Cloudflare
# Pages secrets in the dashboard:
#   TURNSTILE_SECRET_KEY
#   CLOUDFLARE_EMAIL_API_TOKEN
# The email token should be scoped to Email Sending: Edit only.

# ----------------------------------------------------------------------------
# Preview environment
# ----------------------------------------------------------------------------
# Use separate D1/R2 resources for preview deployments so test traffic never
# touches production candidate or employer data.
[env.preview]

[[env.preview.d1_databases]]
binding = "DB"
database_name = "rbp-recruitment-preview"
database_id = "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"

[[env.preview.r2_buckets]]
binding = "CV_BUCKET"
bucket_name = "rbp-recruitment-cvs-preview"

[env.preview.vars]
FIREBASE_PROJECT_ID = "business-plan-applicatio-17047"
BUSINESS_TIMEZONE = "Australia/Perth"
TURNSTILE_SITE_KEY = "REPLACE_WITH_PREVIEW_TURNSTILE_SITE_KEY"
TURNSTILE_ALLOWED_HOSTNAMES = ""
CLOUDFLARE_ACCOUNT_ID = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
RECRUITMENT_EMAIL_FROM = "recruitment@remotebusinesspartner.com.au"
RECRUITMENT_NOTIFICATION_EMAIL = "recruitment@remotebusinesspartner.com.au"
PUBLIC_SITE_URL = "https://remote-business-partner-recruitment-application.pages.dev"
